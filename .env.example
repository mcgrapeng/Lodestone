# lodestone local credentials — copy to .env and fill in. .env is gitignored.

# Server-deploy: bind serve to LAN interface instead of loopback
# Local dev: leave unset (defaults to 127.0.0.1 — safer, can't be hit from network).
# Production: set RADAR_HOST=0.0.0.0 and put nginx/caddy in front for TLS + auth.
# RADAR_HOST=0.0.0.0

# Server-deploy: redirect skill-cache from $HOME/.cache/lodestone to a project-owned
# path (systemd unit, Docker, multi-user). Local dev: leave unset (uses $HOME).
# AI_RADAR_HOME=/var/lib/lodestone

# Postgres connection (used by db/connection.py; env vars also work directly)
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=change-me
PGDATABASE=ai_radar

# Optional scraper backends (scrapers/ has adapters for all three; the orchestrator
# picks the first available one from config.toml [orchestrator].priority).
# Without any of these, radar falls back to plain urllib — still works, just less
# robust on JS-heavy or bot-checked pages.
#
# Remote cloud API — fastest, no local browser needed
# Get a key at https://firecrawl.dev
# FIRECRAWL_API_KEY=fc-xxxx
#
# Local browser engines — install the package + run its setup command
# pip install crawl4ai && crawl4ai-setup
# pip install playwright && playwright install chromium

# Optional LLM providers — for 5-dimension decision analysis (是什么/痛点/同类/优缺/何时选).
# Auto-detected in this order: Anthropic → OpenAI → Ollama. Set ONE of:
#
# Anthropic Claude (recommended — best Chinese quality, ~$0.001/repo with Haiku)
# Get a key at https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-xxxx
# ANTHROPIC_MODEL=claude-3-5-haiku-latest
#
# OpenAI-compatible (any provider exposing /v1/chat/completions)
# OPENAI_API_KEY=sk-xxxx
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com    # 或 Together / Groq / 自建
#
# Ollama 本地（免费，先 ollama serve 启动）
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.1
# LLM_MIN_STARS=50    # 跳过小项目（默认 50）
