# lodestone local credentials — copy to .env and fill in. .env is gitignored.

# Postgres connection (used by db/connection.py; env vars also work directly)
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=change-me
PGDATABASE=ai_radar

# Optional: Firecrawl (remote scraper for github.com/trending — fastest engine)
# Get a key at https://firecrawl.dev — without it, crawl4ai/playwright/urllib are used
# FIRECRAWL_API_KEY=fc-xxxx
